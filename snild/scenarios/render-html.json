{
  "name": "render-html",
  "description": "One render_html call that shows a small chart page.",
  "title": "A small bar chart",
  "steps": [
    {
      "text": "Here is the chart.",
      "tool_calls": [{"name": "render_html", "input": {"html": "<!doctype html><html><body><svg id=c width=320 height=140></svg><script>const data=[4,8,15,16,23];const svg=d3.select('#c');svg.selectAll('rect').data(data).join('rect').attr('x',(d,i)=>i*60+10).attr('y',d=>130-d*5).attr('width',50).attr('height',d=>d*5).attr('fill','steelblue');</script></body></html>"}}]
    },
    {
      "text": "The chart shows five bars rising from 4 to 23."
    }
  ]
}
